{
  "name": "cad-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Portable vector CAD for Obsidian, P&ID and electrical schematics",
  "author": "Alessandro Abrami",
  "homepage": "https://github.com/ide-ale",
  "repository": {
    "type": "git",
    "url": "https://github.com/ide-ale/obsidian-cad-lab.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs --watch",
    "test": "node esbuild.config.mjs --test && node tests/run.mjs",
    "format": "prettier --config .prettierrc.json --no-editorconfig --write \"src/**/*.ts\" \"tests/*.ts\" tests/browser-tests.mjs esbuild.config.mjs styles.css",
    "package": "python3 scripts/package_plugin.py",
    "deploy": "npm run build && python3 scripts/package_plugin.py --install",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "prettier": "^3.10.1",
    "typescript": "^5.8.0",
    "yaml": "^2.9.1"
  },
  "main": "main.js"
}
